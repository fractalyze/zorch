load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_binary(
    name = "bench_merkle_commit",
    srcs = ["bench_merkle_commit.py"],
    deps = [
        "//zorch/commit/testing:koalabear16",
        requirement("jax"),
        requirement("zk_dtypes"),
        requirement("zkbench"),
    ] + GPU_PLUGIN_DEPS,
