load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "merkle",
    srcs = [
        "__init__.py",
        "merkle.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch/utils:bits",
        requirement("frx"),
        requirement("hash_frx"),
    ],
)

py_library(
    name = "strided_merkle",
    srcs = ["strided_merkle.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":merkle",
        "//zorch/utils:bits",
        requirement("frx"),
        requirement("hash_frx"),
    ],
)

py_library(
    name = "ajtai",
    srcs = ["ajtai.py"],
    visibility = ["//visibility:public"],
    # lattice-frx wheels come off the Fractalyze index (lattice-frx#18).
    deps = [
        requirement("frx"),
        requirement("lattice_frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "smcs",
    srcs = ["smcs.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch/commit:merkle",
        "//zorch/utils:bits",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
    ],
)
