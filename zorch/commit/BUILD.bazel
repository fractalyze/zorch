load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "merkle",
    srcs = [
        "__init__.py",
        "merkle.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        requirement("jax"),
    ],
)

py_test(
    name = "merkle_test",
    size = "small",
    srcs = ["merkle_test.py"],
    env = {"JAX_PLATFORMS": "cpu"},
    deps = [
        ":merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("jax"),
        requirement("zk_dtypes"),
    ],
)
