load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "koalabear16",
    srcs = [
        "__init__.py",
        "koalabear16.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        "//zorch/commit:merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
    ],
)

py_library(
    name = "sp1_koalabear16",
    srcs = ["sp1_koalabear16.py"],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        "//zorch/hash/poseidon2",
        requirement("jax"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "smcs_test",
    size = "small",
    srcs = ["smcs_test.py"],
    # poseidon2 permute; CI's published jaxlib can't run it (as merkle_test).
    tags = ["local_only"],
    deps = [
        ":sp1_koalabear16",
        "//zorch/commit:merkle",
        "//zorch/commit:smcs",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "merkle_test",
    # medium: the per-test fixed cost (jit trace + XLA compile of the fused
    # merkle region) sums past the small 60s budget on a loaded CPU.
    size = "medium",
    srcs = ["merkle_test.py"],
    # composite-vmap; CI's published jaxlib can't run it. .bazelrc.ci excludes the
    # local_only tag from CI (full rationale there); local bazel runs it.
    tags = ["local_only"],
    deps = [
        ":koalabear16",
        "//zorch:_composite",
        "//zorch/commit:merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "strided_merkle_test",
    size = "small",
    srcs = ["strided_merkle_test.py"],
    # composite-vmap; CI's published jaxlib can't run it (see merkle_test).
    tags = ["local_only"],
    deps = [
        "//zorch:_composite",
        "//zorch/commit:merkle",
        "//zorch/commit:strided_merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
