load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "koalabear16",
    srcs = [
        "__init__.py",
        "koalabear16.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        "//zorch/commit:merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
    ],
)

py_test(
    name = "merkle_test",
    size = "small",
    srcs = ["merkle_test.py"],
    # manual: vmaps the zorch.fused_region composite -> needs jax#164 (the pytest
    # CI job covers it); drop the tag after the jax pin bump.
    tags = ["manual"],
    deps = [
        ":koalabear16",
        "//zorch/commit:merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "pcs_test",
    size = "small",
    srcs = ["pcs_test.py"],
    deps = [
        "//zorch/commit:pcs",
        requirement("absl_py"),
        requirement("jax"),
    ] + GPU_PLUGIN_DEPS,
)

# basefold_test (and the jagged commit_test) are pytest-only: basefold/jagged
# commit depend on //zorch/coding (no BUILD file; ReedSolomon is pytest-only) and
# vmap the poseidon2 fused_region composite the opt wheel lacks (jax#164, same
# reason merkle_test is manual). They run under pytest only.
