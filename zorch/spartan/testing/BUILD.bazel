load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Shared fixtures: a satisfying toy R1CS builder and the brute-force reference the
# structural cross-check compares the production prover against.
py_library(
    name = "testing",
    srcs = [
        "__init__.py",
        "dense_pcs.py",
        "reference.py",
        "toy.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:transcript",
        "//zorch/poly",
        "//zorch/spartan",
        "//zorch/testkit:random_field",
        requirement("frx"),
    ],
)

# Ligerito-backed PCS bridge (base<->extension) — kept separate so only the
# Ligerito integration test pulls the recursive-PCS deps.
py_library(
    name = "ligerito_pcs",
    srcs = ["ligerito_pcs.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit/testing:koalabear16",
        "//zorch/pcs/ligerito",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

