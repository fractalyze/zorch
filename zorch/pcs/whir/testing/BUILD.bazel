load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "whir_test",
    # Compile-bound: each parameterized (num_vars, k_whir, rate_increase, scheme)
    # case jit-compiles a fresh open+verify graph. `shard_count` runs the cases
    # across parallel processes (absltest honors bazel sharding) — the per-shard
    # wall-clock is well under a `medium` timeout. For single-case iteration use
    # `--test_filter=WhirTest.<case>`.
    size = "medium",
    srcs = ["whir_test.py"],
    shard_count = 4,
    # Real-poseidon2 transcript/commit permute lowers to a composite CI's
    # published frxlib can't run; .bazelrc.ci excludes local_only (local bazel
    # runs it).
    tags = ["local_only"],
    deps = [
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit:strided_merkle",
        "//zorch/pcs/whir",
        "//zorch/testkit:koalabear16",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("hash_frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "_math_test",
    size = "small",
    srcs = ["_math_test.py"],
    deps = [
        "//zorch:transcript",
        "//zorch/pcs/whir",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
