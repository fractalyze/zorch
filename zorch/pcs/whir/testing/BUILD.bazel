load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "whir_test",
    # ~3min: each (num_vars, k_whir, rate_increase) case jit-compiles a fresh
    # open+verify shape, and the rate-increasing cases roughly doubled the matrix.
    size = "large",
    srcs = ["whir_test.py"],
    # Real-poseidon2 transcript/commit permute lowers to a composite CI's
    # published jaxlib can't run; .bazelrc.ci excludes local_only (local bazel
    # runs it).
    tags = ["local_only"],
    deps = [
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit:strided_merkle",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        "//zorch/pcs/whir",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
