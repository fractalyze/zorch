load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "basefold_test",
    size = "small",
    srcs = ["basefold_test.py"],
    # composite-vmap; CI's published jaxlib can't run it. .bazelrc.ci excludes the
    # local_only tag from CI (full rationale there); local bazel runs it.
    tags = ["local_only"],
    deps = [
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit:merkle",
        "//zorch/commit/testing:koalabear16",
        "//zorch/hash/poseidon2/testing:koalabear16",
        "//zorch/pcs:fold",
        "//zorch/pcs/basefold",
        "//zorch/poly",
        "//zorch/testkit:jit_cache",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.py"],
    deps = [
        "//zorch/pcs/basefold",
        requirement("absl_py"),
    ],
)

py_test(
    name = "batching_test",
    size = "small",
    srcs = ["batching_test.py"],
    # Real-poseidon2 transcript permute lowers to a composite CI's published
    # jaxlib can't run; .bazelrc.ci excludes local_only (local bazel runs it).
    tags = ["local_only"],
    deps = [
        "//zorch:transcript",
        "//zorch/hash/poseidon2/testing:koalabear16",
        "//zorch/pcs/basefold",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
