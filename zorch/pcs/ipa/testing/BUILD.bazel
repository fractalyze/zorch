load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "basis",
    srcs = [
        "__init__.py",
        "basis.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        "//zorch/pcs/ipa",
        "//zorch/pcs/testing:curves",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "ipa_test",
    # The GPU-only lax.msm/EC kernel compiles alone run past the small-size
    # 60 s budget (~167 s on an idle RTX 5090); every GPU-lane run of this
    # target has timed out since it landed.
    size = "large",
    srcs = ["ipa_test.py"],
    deps = [
        ":basis",
        "//zorch:transcript",
        "//zorch/pcs/ipa",
        "//zorch/pcs/testing:curves",
        "//zorch/poly",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
