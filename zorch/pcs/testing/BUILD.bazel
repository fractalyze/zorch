load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "curves",
    srcs = [
        "__init__.py",
        "curves.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "protocol_test",
    size = "small",
    srcs = ["protocol_test.py"],
    # composite-vmap; CI's published frxlib can't run it. .bazelrc.ci excludes the
    # local_only tag from CI (full rationale there); local bazel runs it.
    tags = ["local_only"],
    deps = [
        "//zorch:stage",
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit/testing:koalabear16",
        "//zorch/hash/poseidon2/testing:koalabear16",
        "//zorch/pcs:stage",
        "//zorch/pcs/basefold",
        "//zorch/pcs/fri",
        "//zorch/pcs/kzg",
        "//zorch/pcs/kzg/testing:srs",
        "//zorch/testkit:random_field",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "fold_test",
    size = "small",
    srcs = ["fold_test.py"],
    # composite-vmap (Merkle commit marker); CI's published frxlib can't run it.
    # .bazelrc.ci excludes the local_only tag from CI; local bazel runs it.
    tags = ["local_only"],
    deps = [
        "//zorch:prove",
        "//zorch/coding:reed_solomon",
        "//zorch/commit/testing:koalabear16",
        "//zorch/pcs:fold",
        "//zorch/testkit:random_field",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "ring_switch_test",
    size = "small",
    srcs = ["ring_switch_test.py"],
    # binary-field dtype arithmetic (ghash/tower multiplies); CI's published
    # frxlib can't run it. .bazelrc.ci excludes the local_only tag from CI.
    tags = ["local_only"],
    deps = [
        "//zorch/pcs:ring_switch",
        "//zorch/poly",
        "//zorch/utils:binary_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "deep_test",
    size = "small",
    srcs = ["deep_test.py"],
    deps = [
        "//zorch/coding:reed_solomon",
        "//zorch/pcs:deep",
        "//zorch/poly",
        "//zorch/testkit:random_field",
        "//zorch/utils:field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "ring_switch_memory_test",
    size = "medium",
    srcs = ["ring_switch_memory_test.py"],
    tags = ["local_only"],
    deps = [
        "//zorch/pcs:ring_switch",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
