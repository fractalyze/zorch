load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "srs",
    srcs = [
        "__init__.py",
        "srs.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        "//zorch/pcs/kzg",
        requirement("jax"),
        requirement("zk_dtypes"),
    ],
)

py_test(
    name = "kzg_test",
    size = "small",
    srcs = ["kzg_test.py"],
    deps = [
        ":srs",
        "//zorch:transcript",
        "//zorch/pcs/kzg",
        "//zorch/poly",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
