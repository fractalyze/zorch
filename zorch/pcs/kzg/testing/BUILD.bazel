load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "srs",
    srcs = [
        "__init__.py",
        "srs.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        "//zorch/pcs/kzg",
        requirement("jax"),
        requirement("zk_dtypes"),
    ],
)

# `needs_cpu_backend`: the round-trip tests verify via lax.pairing_check, which
# legalizes CPU-only on this stack, while lax.msm is GPU-only — so the verifier
# splits work across both devices and the test needs a CPU backend alongside
# cuda. The GPU CI leg runs strict `cuda` everywhere else; this tag routes such
# host-split tests to a `cuda,cpu` sub-leg (see .github/workflows/ci.yml).
py_test(
    name = "kzg_test",
    size = "small",
    srcs = ["kzg_test.py"],
    tags = ["needs_cpu_backend"],
    deps = [
        ":srs",
        "//zorch:transcript",
        "//zorch/pcs/kzg",
        "//zorch/poly",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
