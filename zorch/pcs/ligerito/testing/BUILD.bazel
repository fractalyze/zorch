load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "ligerito_test",
    # XLA-compile-dominated (fresh compile per run), not asymptotic work; the
    # recursive multi-level round-trips compile several distinct executables.
    size = "large",
    srcs = ["ligerito_test.py"],
    # Real-poseidon2 transcript permute lowers to a composite CI's published
    # frxlib can't run; .bazelrc.ci excludes local_only (local bazel runs it).
    tags = ["local_only"],
    deps = [
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit:merkle",
        "//zorch/commit/testing:koalabear16",
        "//zorch/hash/poseidon2/testing:koalabear16",
        "//zorch/pcs:fold",
        "//zorch/pcs/ligerito",
        "//zorch/poly",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
