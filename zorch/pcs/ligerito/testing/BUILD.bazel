load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "ligerito_test",
    # XLA-compile-dominated (fresh compile per run), not asymptotic work; the
    # recursive multi-level round-trips compile several distinct executables.
    size = "large",
    srcs = ["ligerito_test.py"],
    # Real-poseidon2 transcript permute lowers to a composite CI's published
    # frxlib can't run; .bazelrc.ci excludes local_only (local bazel runs it).
    tags = ["local_only"],
    deps = [
        "//zorch:transcript",
        "//zorch/coding:reed_solomon",
        "//zorch/commit:merkle",
        "//zorch/commit/testing:koalabear16",
        "//zorch/pcs:fold",
        "//zorch/pcs/ligerito",
        "//zorch/poly",
        "//zorch/testkit:koalabear16",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "fold_and_message_test",
    # Traces the marked region alone -- no prove, no transcript permute, so it
    # runs on CI unlike the `local_only` round-trip above.
    size = "small",
    srcs = ["fold_and_message_test.py"],
    deps = [
        "//zorch/pcs/ligerito",
        "//zorch/sumcheck",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
