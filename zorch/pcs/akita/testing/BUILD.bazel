    srcs = ["challenge_test.py"],
    deps = [
        "//zorch:byte_transcript",
        "//zorch/lnp:challenge",
        "//zorch/pcs/akita",
        requirement("absl_py"),
        requirement("hash_frx"),
        requirement("lattice_frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

