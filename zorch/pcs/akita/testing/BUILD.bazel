load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "config_test",
    size = "small",
    srcs = ["config_test.py"],
    deps = [
        "//zorch/pcs/akita",
        requirement("absl_py"),
        requirement("lattice_frx"),
    ],
)

py_test(
    name = "challenge_test",
