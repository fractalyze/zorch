        "//zorch/poly",
        requirement("jax"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "stacked",
    srcs = ["stacked.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch/pcs/basefold:prover",
        "//zorch/pcs/basefold:verifier",
        "//zorch/pcs/jagged:dense",
        "//zorch/poly",
        requirement("jax"),
