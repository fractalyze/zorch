load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "jagged_poly_test",
    size = "small",
    srcs = ["jagged_poly_test.py"],
    deps = [
        "//zorch/pcs/jagged:poly",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("jax"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "dense_test",
    size = "small",
    srcs = ["dense_test.py"],
    deps = [
        "//zorch/pcs/jagged:dense",
        requirement("jax"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "stacked_test",
    size = "small",
    srcs = ["stacked_test.py"],
    deps = [
        "//zorch/pcs/basefold:prover",
        "//zorch/pcs/basefold:verifier",
        "//zorch/pcs/jagged:stacked",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
