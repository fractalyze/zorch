load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Shared reference oracle (scatter_partial_eval) the gather partial_eval
# differential test cross-checks against.
py_library(
    name = "testing",
    srcs = ["__init__.py"],
    deps = [
        "//zorch/pcs/jagged:poly",
        "//zorch/poly",
        requirement("jax"),
    ],
)

py_test(
    name = "jagged_poly_test",
    size = "small",
    srcs = ["jagged_poly_test.py"],
    deps = [
        ":testing",
        "//zorch/pcs/jagged:poly",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("jax"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "dense_test",
    size = "small",
    srcs = ["dense_test.py"],
    deps = [
        "//zorch/pcs/jagged:dense",
        "//zorch/pcs/jagged:poly",
        "//zorch/pcs/jagged:prover",
        requirement("absl_py"),
        requirement("jax"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

# The tests below are composite-vmap: CI's published jaxlib can't run them.
# .bazelrc.ci excludes the local_only tag from CI (full rationale there); local
# bazel runs them.
py_test(
    name = "commit_test",
    size = "small",
    srcs = ["commit_test.py"],
    data = glob(["testdata/**"]),
    tags = ["local_only"],
    deps = [
        "//zorch/coding:reed_solomon",
        "//zorch/commit:smcs",
        "//zorch/commit/testing:sp1_koalabear16",
        "//zorch/hash:compression",
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2",
        "//zorch/pcs/jagged:commit",
        "//zorch/pcs/jagged:region",
        requirement("absl_py"),
        requirement("jax"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

