load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "package_test",
    size = "small",
    srcs = ["package_test.py"],
    deps = [
        "//zorch:grind",
        requirement("absl_py"),
    ],
)

py_test(
    name = "byte_transcript_test",
    size = "small",
    srcs = ["byte_transcript_test.py"],
    deps = [
        "//zorch:byte_transcript",
        requirement("hash_frx"),
        requirement("absl_py"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sha256_field_transcript_test",
    # ~54 s on the CI runners — the small-size 60 s budget times it out
    # whenever the runner is loaded.
    size = "medium",
    srcs = ["sha256_field_transcript_test.py"],
    deps = [
        "//zorch:byte_transcript",
        "//zorch:prove",
        "//zorch:sha256_field_transcript",
        requirement("hash_frx"),
        "//zorch/sumcheck",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

