load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Pure-Python bit helpers — no frx, hence no GPU_PLUGIN_DEPS.
py_test(
    name = "bits_test",
    size = "small",
    srcs = ["bits_test.py"],
    deps = [
        "//zorch/utils:bits",
        requirement("absl_py"),
    ],
)

py_test(
    name = "field_test",
    size = "small",
    srcs = ["field_test.py"],
    deps = [
        "//zorch/utils:field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "binary_field_test",
    size = "small",
    srcs = ["binary_field_test.py"],
    deps = [
        "//zorch/sumcheck",
        "//zorch/utils:binary_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
