load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "permutation_test",
    size = "small",
    srcs = ["permutation_test.py"],
    deps = [
        "//zorch/hash:permutation",
        requirement("absl_py"),
        requirement("jax"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "compression_test",
    size = "small",
    srcs = ["compression_test.py"],
    # manual: vmaps the zorch.fused_region composite -> needs jax#164 (the pytest
    # CI job covers it); drop the tag after the jax pin bump.
    tags = ["manual"],
    deps = [
        "//zorch/hash:compression",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sponge_test",
    size = "small",
    srcs = ["sponge_test.py"],
    # manual: vmaps the zorch.fused_region composite -> needs jax#164 (the pytest
    # CI job covers it); drop the tag after the jax pin bump.
    tags = ["manual"],
    deps = [
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
