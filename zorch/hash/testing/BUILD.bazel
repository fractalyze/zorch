load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "permutation_test",
    size = "small",
    srcs = ["permutation_test.py"],
    deps = [
        "//zorch/hash:permutation",
        requirement("absl_py"),
        requirement("jax"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "compression_test",
    size = "small",
    srcs = ["compression_test.py"],
    deps = [
        "//zorch/hash:compression",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "sponge_test",
    # Compile-heavy: the scanned absorb path compiles a while loop per hash
    # shape, dominated by the vmapped one.
    size = "medium",
    srcs = ["sponge_test.py"],
    deps = [
        "//zorch/hash:sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "duplex_sponge_test",
    size = "medium",
    srcs = ["duplex_sponge_test.py"],
    deps = [
        "//zorch/hash:duplex_sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
