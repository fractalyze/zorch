load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "permutation",
    srcs = [
        "__init__.py",
        "permutation.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_test(
    name = "permutation_test",
    size = "small",
    srcs = ["permutation_test.py"],
    deps = [
        ":permutation",
        requirement("jax"),
    ] + GPU_PLUGIN_DEPS,
)

py_library(
    name = "compression",
    srcs = ["compression.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_test(
    name = "compression_test",
    size = "small",
    srcs = ["compression_test.py"],
    # manual: vmaps the zorch.fused_region composite -> needs jax#164 (the pytest
    # CI job covers it); drop the tag after the jax pin bump.
    tags = ["manual"],
    deps = [
        ":compression",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_library(
    name = "sponge",
    srcs = ["sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_test(
    name = "sponge_test",
    size = "small",
    srcs = ["sponge_test.py"],
    # manual: vmaps the zorch.fused_region composite -> needs jax#164 (the pytest
    # CI job covers it); drop the tag after the jax pin bump.
    tags = ["manual"],
    deps = [
        ":sponge",
        "//zorch/hash/poseidon2/testing:koalabear16",
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)
