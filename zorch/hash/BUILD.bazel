load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "permutation",
    srcs = [
        "__init__.py",
        "permutation.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_library(
    name = "compression",
    srcs = ["compression.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_library(
    name = "sponge",
    srcs = ["sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_library(
    name = "duplex_sponge",
    srcs = ["duplex_sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

# Byte-oriented SHA-256 (FIPS 180-4). A standalone hash, not a Permutation; no
# zk_dtypes / x64 dep. Used by the byte-duplex Fiat-Shamir transcript and batched
# Merkle-over-SHA256.
py_library(
    name = "sha256",
    srcs = ["sha256.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("jax"),
        requirement("numpy"),
    ],
)
