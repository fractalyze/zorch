load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "permutation",
    srcs = [
        "__init__.py",
        "permutation.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_library(
    name = "compression",
    srcs = ["compression.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_library(
    name = "sponge",
    srcs = ["sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_library(
    name = "duplex_sponge",
    srcs = ["duplex_sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

# The ByteHash seam — the byte sibling of Permutation. A byte hash is
# digest(uint8[B, L]) -> uint8[B, digest_size]; SHA-256 (sha256.py) is one impl,
# BLAKE3 / Keccak drop in unchanged, the construction hidden behind digest.
py_library(
    name = "byte_hash",
    srcs = ["byte_hash.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("jax"),
        requirement("numpy"),
    ],
)

# Byte-oriented SHA-256 (FIPS 180-4): the `digest` batch hash, the streaming
# Merkle-Damgard midstate (scan-threadable core), and the `Sha256` / `HashlibSha256`
# ByteHash impls. A standalone hash, not a Permutation; no zk_dtypes / x64 dep. Used
# by the byte-duplex Fiat-Shamir transcript and batched Merkle-over-SHA256.
py_library(
    name = "sha256",
    srcs = ["sha256.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_hash",
        requirement("jax"),
        requirement("numpy"),
    ],
)
