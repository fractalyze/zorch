load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "permutation",
    srcs = [
        "__init__.py",
        "permutation.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_library(
    name = "compression",
    srcs = ["compression.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)

py_library(
    name = "sponge",
    srcs = ["sponge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":permutation",
        requirement("jax"),
    ],
)
