load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_library(
    name = "poseidon2",
    srcs = [
        "__init__.py",
        "linear.py",
        "params.py",
        "poseidon2.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:fusion",
        "//zorch/hash:permutation",
        requirement("jax"),
        requirement("numpy"),
    ],
)

_DEPS = [
    ":poseidon2",
    requirement("jax"),
    requirement("numpy"),
    requirement("zk_dtypes"),
]

py_test(
    name = "params_test",
    size = "small",
    srcs = ["params_test.py"],
    deps = _DEPS + GPU_PLUGIN_DEPS,
)

py_test(
    name = "permute_shape_test",
    size = "small",
    srcs = ["permute_shape_test.py"],
    # manual: vmaps the zorch.fused_region composite -> needs jax#164 (the pytest
    # CI job covers it); drop the tag after the jax pin bump.
    tags = ["manual"],
    deps = _DEPS + GPU_PLUGIN_DEPS,
)
