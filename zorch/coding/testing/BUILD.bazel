load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "additive_reed_solomon_test",
    size = "medium",
    srcs = ["additive_reed_solomon_test.py"],
    deps = [
        "//zorch/coding:additive_reed_solomon",
        "//zorch/coding:foldable_code",
        "//zorch/coding:linear_code",
        requirement("absl_py"),
        requirement("frx"),
        requirement("numpy"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "reed_solomon_test",
    size = "medium",
    srcs = ["reed_solomon_test.py"],
    deps = [
        "//zorch/coding:foldable_code",
        "//zorch/coding:linear_code",
        "//zorch/coding:reed_solomon",
        "//zorch/testkit:random_field",
        requirement("absl_py"),
        requirement("frx"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "tensor_code_test",
    size = "small",
    srcs = ["tensor_code_test.py"],
    deps = [
        "//zorch/coding:reed_solomon",
