# Shared LogUp-GKR fixtures + chain runners (random_first_layer, prove_gkr,
# verify_gkr) — used by the package tests.
py_library(
    name = "testing",
    srcs = [
        "__init__.py",
        "_jagged_reference.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:round",
        "//zorch:transcript",
        "//zorch/logup_gkr",
        "//zorch/sumcheck/jagged",
        "//zorch/testkit:random_field",
        "//zorch/testkit:transcript",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

