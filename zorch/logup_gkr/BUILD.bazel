load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# LogUp-GKR: fractional-sum circuit (dense and jagged layouts), provers
# (dense per-variable LogUp sumcheck round + layer chain; jagged materialized
# layer round), and verifiers. The package's testing runners import them all,
# so the verifiers ride along here.
py_library(
    name = "logup_gkr",
    srcs = [
        "__init__.py",
        "circuit.py",
        "jagged_prover.py",
        "jagged_verifier.py",
        "prover.py",
        "round_export.py",
        "verifier.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:round",
        "//zorch:transcript",
        "//zorch:verify",
        "//zorch/poly",
        "//zorch/sumcheck",
        "//zorch/utils:bits",
        # round_export's on-disk cache backend; the import is guarded, but
        # without the wheel in runfiles ZORCH_EXPORT_CACHE_DIR is a no-op.
        requirement("flatbuffers"),
        requirement("jax"),
        requirement("numpy"),
    ],
)
