load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# LogUp-GKR: fractional-sum circuit (dense and jagged layouts), provers
# (dense per-variable LogUp sumcheck round + layer chain; jagged materialized
# layer round), and verifiers. The package's testing runners import them all,
# so the verifiers ride along here.
py_library(
    name = "logup_gkr",
    srcs = [
        "__init__.py",
        "_jagged_buffers.py",
        "_jagged_composites.py",
        "_jagged_export.py",
        "_jagged_fs.py",
        "_jagged_rounds.py",
        "_jagged_schedule.py",
        "_jagged_types.py",
        "circuit.py",
        "jagged_prover.py",
        "jagged_verifier.py",
        "prover.py",
        "verifier.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:round",
        "//zorch:transcript",
        "//zorch:verify",
        "//zorch/poly",
        "//zorch/sumcheck",
        "//zorch/utils:bits",
        requirement("jax"),
        requirement("numpy"),
    ],
)
