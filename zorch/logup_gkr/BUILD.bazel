load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# LogUp-GKR: fractional-sum circuit (dense and jagged layouts), prover
# (per-variable LogUp sumcheck round, one GKR layer, the layer chain), and
# verifier. The package's testing runners import all three, so the verifier
# rides along here.
py_library(
    name = "logup_gkr",
    srcs = [
        "__init__.py",
        "circuit.py",
        "prover.py",
        "verifier.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:round",
        "//zorch:transcript",
        "//zorch:verify",
        "//zorch/poly",
        "//zorch/sumcheck",
        "//zorch/utils:bits",
        requirement("jax"),
        requirement("numpy"),
    ],
)
