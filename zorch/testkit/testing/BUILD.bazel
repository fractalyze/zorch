    deps = [
        "//zorch/testkit:fusion",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

py_test(
    name = "transcript_test",
    size = "small",
    srcs = ["transcript_test.py"],
    deps = [
        "//zorch:transcript",
        "//zorch/hash:permutation",
