load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "random_field",
    srcs = [
        "__init__.py",
        "random_field.py",
    ],
    visibility = ["//zorch:__subpackages__"],
    deps = [
        requirement("frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "fusion",
    srcs = ["fusion.py"],
    visibility = ["//zorch:__subpackages__"],
    deps = [requirement("frx")],
)

py_library(
    name = "jit_cache",
    srcs = ["jit_cache.py"],
    visibility = ["//zorch:__subpackages__"],
)

# Public: consumers' IOP tests reuse the same cheap test transcript as
# zorch's own tests (promoted per-target, like logup_gkr/testing).
py_library(
    name = "transcript",
    srcs = ["transcript.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:transcript",
        requirement("frx"),
    ],
)
