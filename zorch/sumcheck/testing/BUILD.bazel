load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

# Shared reference oracles (product, eval_mle_oracle) the prove/verifier tests
# cross-check the production sumcheck against.
py_library(
    name = "testing",
    srcs = ["__init__.py"],
    deps = [requirement("jax")],
)

py_test(
    name = "prove_test",
    size = "small",
    srcs = ["prove_test.py"],
    deps = [
        ":testing",
        "//zorch/poly",
        "//zorch/sumcheck",
        "//zorch/testkit:random_field",
        "//zorch/testkit:transcript",
        requirement("absl_py"),
        requirement("jax"),
        requirement("zk_dtypes"),
    ] + GPU_PLUGIN_DEPS,
)

