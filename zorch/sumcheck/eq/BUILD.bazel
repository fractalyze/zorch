load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# EqPoly sumcheck variants: EqPolySC (Algorithm 5), the small-value optimization
# (Algorithm 6), and its accumulator pre-computation (Procedure 9). Built on the
# generic sumcheck domain + sqrt-space engine in the parent package.
py_library(
    name = "eq",
    srcs = [
        "__init__.py",
        "accumulators.py",
        "eq_poly.py",
        "small_value.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:prove",
        "//zorch:round",
        "//zorch:transcript",
        "//zorch/poly",
        "//zorch/sumcheck",
        "//zorch/utils:bits",
        "//zorch/utils:field",
        requirement("jax"),
    ],
)
