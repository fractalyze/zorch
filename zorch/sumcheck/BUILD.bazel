load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# Sumcheck prover + verifier rounds, and the multilinear sumcheck scan driver
# (`prove`, with the register-resident `zorch.sumcheck` marker).
py_library(
    name = "sumcheck",
    srcs = [
        "__init__.py",
        "domain.py",
        "gruen.py",
        "prover.py",
        "reduce.py",
        "sqrt_space.py",
        "stage.py",
        "univariate_skip.py",
        "verifier.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch:challenge",
        "//zorch:prove",
        "//zorch:round",
        "//zorch:stage",
        "//zorch:transcript",
        "//zorch:verify",
        "//zorch/poly",
        "//zorch/utils:bits",
        "//zorch/utils:field",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)
