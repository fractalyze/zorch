load("@rules_python//python:defs.bzl", "py_test")
load("@zorch_pip//:requirements.bzl", "requirement")
load("//:defs.bzl", "GPU_PLUGIN_DEPS")

py_test(
    name = "challenge_test",
    size = "small",
    srcs = ["challenge_test.py"],
    deps = [
        "//zorch/lnp:challenge",
        requirement("absl_py"),
        requirement("lattice_frx"),
        requirement("numpy"),
    ],
)

py_test(
    name = "transcript_test",
    size = "small",
    srcs = ["transcript_test.py"],
    deps = [
        "//zorch:byte_transcript",
        "//zorch/lnp:transcript",
        requirement("absl_py"),
        requirement("hash_frx"),
        requirement("numpy"),
    ] + GPU_PLUGIN_DEPS,
)

