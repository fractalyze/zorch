load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# The CompositeOp-absent fallback every composite marker shares (jaxlib-compat
# shim; auto-retires once the composite-capable wheel ships).
py_library(
    name = "_composite",
    srcs = ["_composite.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_library(
    name = "fusion",
    srcs = ["fusion.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":_composite",
        requirement("jax"),
    ],
)

py_library(
    name = "constraint_eval",
    srcs = ["constraint_eval.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":_composite",
        requirement("jax"),
    ],
)

# The folding spine: the `Round`/chain base, the Fiat-Shamir transcript, and the
# generic 2-to-1 `prove` driver. Wired for Bazel so the benchmark py_binary
# targets (and downstream consumers via @zorch) can depend on them; the round
# bodies themselves are exercised under pytest.

py_library(
    name = "transcript",
    srcs = [
        "__init__.py",
        "transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch/hash:permutation",
        requirement("jax"),
        requirement("zk_dtypes"),
    ],
)

# Host-side byte-oriented Fiat-Shamir (SHA-256 Merlin duplex). Pure-Python /
# hashlib — no jax, no zk_dtypes, no x64. The byte sibling of `transcript.py`;
# see docs/transcript.md for the two-transcript taxonomy.
py_library(
    name = "byte_transcript",
    srcs = [
        "__init__.py",
        "byte_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [],
)

# Device sibling of `byte_transcript`: identical Merlin-over-SHA-256 framing, but
# the SHA-256 compression runs on-device via the `zorch.sha256` marker instead of
# host hashlib (a byte Fiat-Shamir chain that lowers to a GPU kernel).
py_library(
    name = "device_byte_transcript",
    srcs = [
        "__init__.py",
        "device_byte_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_transcript",
        "//zorch/hash:sha256",
        requirement("jax"),
        requirement("numpy"),
    ],
)

py_library(
    name = "round",
    srcs = ["round.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":transcript",  # also the package-init carrier for this dir
        requirement("jax"),
    ],
)

py_library(
    name = "prove",
    srcs = ["prove.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":round",
        ":transcript",
    ],
)

py_library(
    name = "verify",
    srcs = ["verify.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":round",
        ":transcript",
        requirement("jax"),
    ],
)
