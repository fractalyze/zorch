load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

# The CompositeOp-absent fallback every composite marker shares (jaxlib-compat
# shim; auto-retires once the composite-capable wheel ships).
py_library(
    name = "_composite",
    srcs = ["_composite.py"],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_library(
    name = "fusion",
    srcs = ["fusion.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":_composite",
        requirement("jax"),
    ],
)

py_library(
    name = "constraint_eval",
    srcs = ["constraint_eval.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":_composite",
        requirement("jax"),
    ],
)

# The folding spine: the `Round`/chain base, the Fiat-Shamir transcript, and the
# generic 2-to-1 `prove` driver. Wired for Bazel so the benchmark py_binary
# targets (and downstream consumers via @zorch) can depend on them; the round
# bodies themselves are exercised under pytest.

# The one windowed PoW grind search engine every transcript's grind runs on.
py_library(
    name = "grind",
    srcs = [
        "__init__.py",
        "grind.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("jax")],
)

py_library(
    name = "transcript",
    srcs = [
        "__init__.py",
        "transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":fusion",
        ":grind",
        "//zorch/hash:permutation",
        requirement("jax"),
        requirement("zk_dtypes"),
    ],
)

# Host-side byte-oriented Fiat-Shamir (SHA-256 Merlin duplex). Pure-Python /
# hashlib — no jax, no zk_dtypes, no x64. The byte sibling of `transcript.py`;
# see docs/transcript.md for the two-transcript taxonomy.
# Merlin-over-hash byte duplex (`ByteHashTranscript`) parameterized by a `ByteHash`
# — one class backs both the host (`HostSha256`) and device (`Sha256` marker)
# byte challengers; the substrate is a value it carries, not a class it hardcodes.
py_library(
    name = "byte_transcript",
    srcs = [
        "__init__.py",
        "byte_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//zorch/hash:byte_hash",
        requirement("numpy"),
    ],
)

# Field-element `Transcript` surface over the streaming SHA-256 core: the device
# SHA-256 sibling of the algebraic `DuplexTranscript`, scan-threadable under @jit.
py_library(
    name = "sha256_field_transcript",
    srcs = [
        "__init__.py",
        "sha256_field_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_transcript",
        ":grind",
        "//zorch/hash:sha256",
        requirement("jax"),
        requirement("numpy"),
    ],
)

py_library(
    name = "round",
    srcs = ["round.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":transcript",  # also the package-init carrier for this dir
        requirement("jax"),
    ],
)

py_library(
    name = "prove",
    srcs = ["prove.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":round",
        ":transcript",
    ],
)

py_library(
    name = "verify",
    srcs = ["verify.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":round",
        ":transcript",
        requirement("jax"),
    ],
)
