load("@rules_python//python:defs.bzl", "py_library")
load("@zorch_pip//:requirements.bzl", "requirement")

py_library(
    name = "constraint_eval",
    srcs = ["constraint_eval.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("frx"),
        requirement("hash_frx"),
    ],
)

# The folding spine: the `Round`/chain base, the Fiat-Shamir transcript, and the
# generic 2-to-1 `prove` driver. Wired for Bazel so the benchmark py_binary
# targets (and downstream consumers via @zorch) can depend on them; the round
# bodies themselves are exercised under pytest.

# The one windowed PoW grind search engine every transcript's grind runs on.
py_library(
    name = "grind",
    srcs = [
        "__init__.py",
        "grind.py",
    ],
    visibility = ["//visibility:public"],
    deps = [requirement("frx")],
)

py_library(
    name = "transcript",
    srcs = [
        "__init__.py",
        "transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":grind",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("typing_extensions"),
        requirement("zk_dtypes"),
    ],
)

# Host-side byte-oriented Fiat-Shamir (SHA-256 Merlin duplex). Pure-Python /
# hashlib — no frx, no zk_dtypes, no x64. The byte sibling of `transcript.py`;
# see docs/blocks/transcript.md for the two-transcript taxonomy.
# Merlin-over-hash byte duplex (`ByteHashTranscript`) parameterized by a `ByteHash`
# — one class backs both the host (`HostSha256`) and device (`Sha256` marker)
# byte challengers; the substrate is a value it carries, not a class it hardcodes.
py_library(
    name = "byte_transcript",
    srcs = [
        "__init__.py",
        "byte_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("hash_frx"),
        requirement("numpy"),
    ],
)

# Field-element `Transcript` surface over the streaming BLAKE3 core: the same
# construction as the SHA-256 row, with BLAKE3's XOF squeeze and a proof-of-work
# pre-image width the consumer's verifier fixes.
py_library(
    name = "blake3_field_transcript",
    srcs = [
        "__init__.py",
        "blake3_field_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_transcript",
        ":grind",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("numpy"),
    ],
)

# Field-element `Transcript` surface over the streaming SHA-256 core: the device
# SHA-256 sibling of the algebraic `DuplexTranscript`, scan-threadable under @jit.
py_library(
    name = "sha256_field_transcript",
    srcs = [
        "__init__.py",
        "sha256_field_transcript.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":byte_transcript",
        ":grind",
        requirement("frx"),
        requirement("hash_frx"),
        requirement("numpy"),
    ],
)

py_library(
    name = "challenge",
    srcs = ["challenge.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":transcript",
        requirement("frx"),
        requirement("zk_dtypes"),
    ],
)

py_library(
    name = "round",
    srcs = ["round.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":transcript",  # also the package-init carrier for this dir
        requirement("frx"),
    ],
)

py_library(
    name = "stage",
    srcs = ["stage.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":transcript",
        requirement("frx"),
    ],
)

py_library(
    name = "prove",
    srcs = ["prove.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":round",
        ":transcript",
    ],
)

py_library(
    name = "scan_body",
    srcs = ["scan_body.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "verify",
    srcs = ["verify.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":round",
        ":transcript",
        requirement("frx"),
    ],
)
