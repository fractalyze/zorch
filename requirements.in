# zorch runtime dependencies.
#
# Pulled from the Fractalyze package index alongside upstream PyPI:
#   pip install -r requirements.in \
#     --extra-index-url https://fractalyze.github.io/pypi/simple/
#
# zorch is proving-scheme- and zkVM-agnostic, so it deliberately does NOT
# depend on any zkVM package (riscv-witness, rw-constraints, …). zk_dtypes
# (native finite-field dtypes) arrives via frx but is pinned here directly,
# and the two must move together: the frx extension-field lowering reads
# `efinfo.modulus_low_coeffs` (zk_dtypes >= 0.0.6), and this frx build
# registers the binary-field dtypes (tower t0..t7 + flat GHASH) in the
# frontend, which requires zk_dtypes >= 0.0.10.
absl-py
numpy
# PEP 696 TypeVar defaults, which `typing` gains only in 3.13.
typing-extensions
frx==0.10.2.dev20260910150749
frxlib==0.10.2.dev20260910150749
frx-cuda12-pjrt==0.10.2.dev20260910150749
frx-cuda12-plugin==0.10.2.dev20260910150749
# 0.0.17 is the frx floor: this frx build registers the ed25519 twisted-Edwards
# G1 point dtypes, so it resolves `zk_dtypes.ed25519_g1_affine`, which does not
# exist before 0.0.17. An older pin still resolves — the failure lands at import
# as `AttributeError: module 'zk_dtypes' has no attribute 'ed25519_g1_affine'`
# in every test — so the floor has to be pinned here rather than left to the
# resolver, and it must move in the same commit as the frx quad above.
# lattice-frx's 0.0.14 floor (`prime_field` arrives there), the classical-curve
# field dtypes (>= 0.0.15), and the older frx floors (>= 0.0.6, >= 0.0.10) are
# satisfied a fortiori.
zk-dtypes==0.0.17
# The symmetric layer (permutations, sponges, compressions, byte hashes) and the
# `fused_region` / `composite` marker seam they lower through. It sits BELOW
# zorch so `sig-frx` can share it without taking a proving-block dependency, so
# zorch imports it rather than owning a copy.
#
# It used to pull in `blake3` transitively, for host byte-hash rows it no longer
# ships (fractalyze/hash-frx#324 left every row device-only); the pin below now
# carries that binding directly, for tests.
hash-frx==0.2.0.dev20260911005315
# TEST-ONLY: `//zorch/testkit:byte_hash`'s `HostBlake3` is the out-of-tree oracle
# the BLAKE3 transcript suites hash against, and BLAKE3 is the one family with no
# `hashlib` fallback to serve instead. It is here rather than in
# `requirements-dev.in` because only this file feeds `@zorch_pip`, which is where
# a bazel target reaches it; what keeps it out of the wheel is `pyproject.toml`,
# which declares the runtime deps. Prebuilt wheels everywhere, so no Rust.
blake3
# The lattice substrate (negacyclic ring + NTT, RNS, norms) behind the
# module-lattice commitments in `zorch/commit/ajtai.py`. Same layering story
# as hash-frx: it sits BELOW zorch (enc-frx and sig-frx share it), so zorch
# imports it rather than owning a copy. Dev wheels off the Fractalyze index.
lattice-frx==0.0.1.dev20260826211222

# Benchmark harness (shared across fractalyze repos); used only by the
# //zorch/...:*bench* py_binary targets, not by the zorch wheel itself.
zkbench==0.4.0
