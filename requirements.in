# zorch runtime dependencies.
#
# Pulled from the Fractalyze package index alongside upstream PyPI:
#   pip install -r requirements.in \
#     --extra-index-url https://fractalyze.github.io/pypi/simple/
#
# zorch is proving-scheme- and zkVM-agnostic, so it deliberately does NOT
# depend on any zkVM package (riscv-witness, rw-constraints, …). zk_dtypes
# (native finite-field dtypes) arrives via frx but is pinned here directly,
# and the two must move together: the frx extension-field lowering reads
# `efinfo.modulus_low_coeffs` (zk_dtypes >= 0.0.6), and this frx build
# registers the binary-field dtypes (tower t0..t7 + flat GHASH) in the
# frontend, which requires zk_dtypes >= 0.0.10.
absl-py
numpy
# PEP 696 TypeVar defaults, which `typing` gains only in 3.13.
typing-extensions
frx==0.10.0.dev20260725093147
frxlib==0.10.0.dev20260725093147
frx-cuda12-pjrt==0.10.0.dev20260725093147
frx-cuda12-plugin==0.10.0.dev20260725093147
zk-dtypes==0.0.10

# Benchmark harness (shared across fractalyze repos); used only by the
# //zorch/...:*bench* py_binary targets, not by the zorch wheel itself.
zkbench==0.4.0
