jaxlib==0.10.0.dev20260708150706
jax-cuda12-pjrt==0.10.0.dev20260708150706
jax-cuda12-plugin==0.10.0.dev20260708150706
zk-dtypes==0.0.8

# Benchmark harness (shared across fractalyze repos); used only by the
# //zorch/...:*bench* py_binary targets, not by the zorch wheel itself.
zkbench==0.4.0
