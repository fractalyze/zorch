# Remote execution platform for Buildbarn RBE (--config=remote).
#
# Buildbarn matches exec_properties EXACTLY against what workers advertise; any
# extra key here strands every action with "No workers exist for platform". The
# pool runs generic upstream Buildbarn images (CPU x86_64, no GPU), so only the
# CPU leg executes remotely — the GPU leg falls back to local execution on the
# self-hosted GPU runner (see the spawn_strategy fallback on :remote in
# //.bazelrc). Mirrors fractalyze/jax_fork //rbe:linux_remote.
package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_remote",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "cpu_arch": "x86_64",
    },
)
