# bazel 9 defaults to bzlmod (WORKSPACE is gone), so no enable flags needed.
build --announce_rc
test --test_output=errors

# Tests are backend-agnostic; CPU is the default (not a requirement) so plain
# `bazel test` is deterministic on any machine. CI overrides it per matrix leg
# via --test_env (the GPU leg pins JAX_PLATFORMS=cuda). Previously pinned
# per-target in each py_test's env, which made the backend unselectable from CI.
test --test_env=JAX_PLATFORMS=cpu

# Buildbarn remote execution (--config=remote). The frontend endpoint is the
# proto RBE node; the mTLS client material is machine-local and passed
# per-invocation (CI supplies the --tls_* flags pointing at /etc/rbe-certs on the
# self-hosted runners — see .github/workflows/ci.yml). Workers are CPU-only
# (//rbe:linux_remote), so the spawn_strategy fallback runs GPU and other
# no-remote-exec actions locally. Mirrors fractalyze/jax_fork's :remote.
build:remote --remote_executor=grpcs://43.201.213.94:8980
build:remote --remote_cache=grpcs://43.201.213.94:8980
build:remote --remote_instance_name=
build:remote --remote_download_minimal
build:remote --jobs=256
build:remote --extra_execution_platforms=//rbe:linux_remote
build:remote --remote_timeout=3600
build:remote --spawn_strategy=remote,worker,standalone,local

# Local, machine-specific overrides (gitignored).
try-import %workspace%/.bazelrc.user
